# Copy to .env and adjust if needed.
# cp .env.example .env

# PostgreSQL (Docker)
POSTGRES_DB=bayarea_tech_jobs_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Jupyter (Docker)
JUPYTER_PORT=8888

# Host / Cursor notebooks: use localhost + published port.
# Docker Compose overrides this inside the notebook container to host "db".
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/bayarea_tech_jobs_db
