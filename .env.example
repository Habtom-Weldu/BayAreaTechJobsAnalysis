# Copy to .env and adjust if needed.
# cp .env.example .env

# PostgreSQL (Docker)
POSTGRES_DB=bayarea_tech_jobs_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Jupyter (Docker)
JUPYTER_PORT=8888

# Notebook / SQLAlchemy connection
# From inside Docker containers, host is "db".
# From your host machine (Cursor, local psql), use localhost and POSTGRES_PORT.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/bayarea_tech_jobs_db

# Optional host-side connection overrides
# PGHOST=localhost
# PGPORT=5433
# PGPASSWORD=postgres
